    "expo-localization": "~58.0.5",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
