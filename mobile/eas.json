{
  "cli": { "version": ">=18.0.0", "appVersionSource": "remote" },
  "build": {
    "ios-simulator": {
      "node": "24.19.0",
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "android-preview": {
      "node": "24.19.0",
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview",
