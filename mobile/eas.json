    },
    "testflight": {
      "node": "24.19.0",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "ios": { "credentialsSource": "remote" }
    }
  },
  "submit": { "testflight": { "ios": {} } }
}
